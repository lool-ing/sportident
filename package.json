{
  "name": "@lool-ing/sportident",
  "version": "0.1.0",
  "description": "Node.js library for reading SPORTident orienteering cards via BSM7/8-USB",
  "keywords": [
    "sportident",
    "orienteering",
    "serialport",
    "bsm8",
    "siac"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "homepage": "https://github.com/lool-ing/sportident#readme",
  "bugs": {
    "url": "https://github.com/lool-ing/sportident/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lool-ing/sportident.git"
  },
  "packageManager": "pnpm@10.34.6",
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "lool-readout": "./dist/bin/lool-readout.cjs",
    "lool-trainer": "./dist/bin/lool-trainer.cjs"
  },
  "scripts": {
    "build": "tsup",
    "dev:readout": "node src/bin/lool-readout.ts",
    "dev:record": "node --enable-source-maps src/bin/lool-readout.ts --record",
    "dev:replay": "node --enable-source-maps src/bin/lool-readout.ts --replay",
    "dev:trainer": "node --enable-source-maps src/bin/lool-trainer.ts",
    "test": "node --test --test-reporter=spec 'src/**/*.test.ts'",
    "test:watch": "node --test --watch --test-reporter=spec 'src/**/*.test.ts'",
    "lint": "eslint src && bash scripts/check-mit-attribution.sh",
    "typecheck": "tsc --noEmit",
    "changelog": "git-cliff --bump --unreleased --prepend CHANGELOG.md",
    "release:version": "git-cliff --bumped-version",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "lefthook"
    ]
  }
}
